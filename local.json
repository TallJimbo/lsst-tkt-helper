{
  "module": "tkt.rubin",
  "cls": "RubinEnvironment",
  "repos_yaml": "/home/jbosch/LSST/repos/etc/repos.yaml",
  "workspace_path": "/home/jbosch/LSST/tkt",
  "externals": {
    "testdata_subaru": "/home/jbosch/LSST/testdata/testdata_subaru",
    "testdata_decam": "/home/jbosch/LSST/testdata/testdata_decam",
    "testdata_cfht": "/home/jbosch/LSST/testdata/testdata_cfht",
    "testdata_ci_hsc": "/home/jbosch/LSST/testdata/testdata_ci_hsc",
    "testdata_ci_imsim": "/home/jbosch/LSST/testdata/testdata_ci_imsim",
    "testdata_jointcal": "/home/jbosch/LSST/testdata/testdata_jointcal",
    "testdata_latiss_cpp": "/home/jbosch/LSST/testdata/testdata_latiss_cpp",
    "ap_verify_ci_hits2015": "/home/jbosch/LSST/testdata/ap_verify_ci_hits2015",
    "ap_verify_ci_cosmos_pdr2": "/home/jbosch/LSST/testdata/ap_verify_ci_cosmos_pdr2"
  },
  "default_tools": [
    "zed",
    "pyright",
    "sandbox",
    "precommit",
    "superpowers",
    "direnv"
  ],
  "tools": {
    "pyright": {
      "module": "tkt.pyright",
      "cls": "Pyright"
    },
    "zed": {
      "module": "tkt.zed",
      "cls": "Zed"
    },
    "openspec": {
      "module": "tkt.openspec",
      "cls": "OpenSpec",
      "store": "lsst"
    },
    "superpowers": {
      "module": "tkt.superpowers",
      "cls": "Superpowers",
      "path": "/home/jbosch/LSST/superpowers-docs"
    },
    "sandbox": {
      "module": "tkt.sandbox",
      "cls": "Sandbox",
      "command": ["/home/jbosch/.opencode/bin/opencode", "acp"],
      "mounts": {
        "ro": [
          "~/LSST/install",
          "~/LSST/tkt2",
          "~/LSST/repos",
          "~/.opencode",
          "~/.gitconfig",
          "~/.gitignore-global",
          "~/.bashrc",
          "~/.profile",
          "~/.bash_profile",
          "~/.inputrc",
          "~/.nvm/versions/node/v24.18.0",
          "~/.config/opencode",
          "~/.agents/skills",
          "~/.tkt"
        ],
        "rw": [
          "~/.local/share/opencode",
          "~/.cache/opencode",
          "~/.cache/prek",
          "~/.eups",
          "~/LSST/superpowers-docs"
        ]
      },
      "port": [8080, 8090],
      "env": {
        "GIT_EDITOR": "true",
        "GIT_SEQUENCE_EDITOR": "true"
      }
    },
    "precommit": {
      "module": "tkt.precommit",
      "cls": "PreCommit"
    },
    "direnv": {
      "module": "tkt.direnv",
      "cls": "DirEnv",
      "env": ["LSST_CONDA_ENV_NAME", "NVM_DIR"],
      "scripts": [
        "/home/jbosch/.nvm/nvm.sh",
        "/home/jbosch/LSST/install/loadLSST.bash"
      ]
    }
  },
  "proxy": {
    "rewrite": [
      {
        "client": "zed",
        "model": "deepseek-ai/DeepSeek-V4-Flash-0731",
        "params": {
          "temperature": null,
          "top_p": 0.95
        }
      }
    ]
  }
}
